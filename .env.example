# Sahaayak configuration.
# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# ── Gemma ───────────────────────────────────────────────────────────────────
# This is the only intelligence in the system. Everything else here is storage
# or an audio codec.
#
# Local Ollama needs no key. Install Ollama, then:
#   ollama pull gemma4:e4b-it-qat
#
# The e4b QAT build is ~6.1 GB and fits a 6 GB GPU. On less VRAM use
# gemma4:e2b-it-qat (~4.3 GB). Both read text and images.
GEMMA_LOCAL_ORIGIN=http://localhost:11434
GEMMA_LOCAL_MODEL=gemma4:e4b-it-qat

# Optional hosted fallback. Tried only when no local host answers, so a public
# demo works for someone who has not installed Ollama.
# Key from https://ollama.com/settings/keys
# OLLAMA_API_KEY=
# GEMMA_CLOUD_ORIGIN=https://ollama.com
# GEMMA_CLOUD_MODEL=gemma4:cloud

# Set true to skip the local host entirely and go straight to the hosted one.
# GEMMA_DISABLE_LOCAL=false

# Gemma 4's smaller variants have an audio encoder and can transcribe speech
# directly. That path is not dependable through Ollama yet, so it is off by
# default and a dedicated ASR handles the microphone.
# See docs/gemma-integration.md for the open upstream bugs.
GEMMA_AUDIO_ENABLED=false
GEMMA_AUDIO_MODEL=gemma4:12b

# Local inference on a laptop GPU is slower than a cloud API.
# How long to let the local model work before also trying the cloud.
# The first call after Ollama starts spends ~70s loading weights; hedging means
# a resident is not left waiting for it. Local still wins every call after.
GEMMA_HEDGE_MS=20000
GEMMA_TIMEOUT_MS=120000

# ── Storage ─────────────────────────────────────────────────────────────────
# 'local' keeps everything in .data/ as JSON: no Firebase account, no quota,
# and the app runs with the network off. Leave the Firebase block below empty
# to use it. Set the Firebase values instead to use Firestore.
STORE_BACKEND=local
NEXT_PUBLIC_STORE_BACKEND=local

# ── Speech ──────────────────────────────────────────────────────────────────
# Used only at the audio edges: microphone in, speaker out. No reasoning.
# Optional. Without it, voice reporting is unavailable and typing still works.
SARVAM_API_KEY=

# ── Firebase ────────────────────────────────────────────────────────────────
# Storage and auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server side. The private key is a real secret: never commit it, and rotate it
# if it is ever pasted anywhere public.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
