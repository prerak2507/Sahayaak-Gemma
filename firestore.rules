rules_version = '2';

// Firestore security rules for Sahaayak.
//
// The app does not depend on these. Every screen reads the reports board
// through /api/needs, where the admin SDK reads and the server decides what is
// exposed, so the browser never holds a database credential. That is the safer
// arrangement and it is the one shipped.
//
// These rules exist for two reasons. They document what the data actually is,
// and they let you grant direct client reads if you would rather have live
// Firestore subscriptions than polling.
//
// To apply:
//   firebase deploy --only firestore:rules
// or paste into Firebase console, Firestore Database, Rules, Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Civic reports. A municipal complaints board is public information: the
    // whole point is that a resident can see their report and its progress
    // without an account. Writes go through the server, which triages and
    // shapes the document, so the client never writes here directly.
    match /needs/{needId} {
      allow read: if true;
      allow write: if false;
    }

    // Reports the system turned away, with the reason. Readable so refusals can
    // be audited rather than disappearing silently.
    match /rejected_reports/{reportId} {
      allow read: if true;
      allow write: if false;
    }

    // Crew assignments. Contain worker identities, so signed-in only.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // People. Never public.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Operational logs.
    match /telemetry_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
